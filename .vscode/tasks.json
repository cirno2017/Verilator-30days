{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Verilator Head",
            "type": "shell",
            "command": "verilator",
            "args": [
                "--cc",
                "delayed_done.v",
                "--top-module",
                "delayed_done"
            ],
            "problemMatcher": []
        },
        {
            "label": "Verilator Build",
            "type": "shell",
            "command": "verilator",
            "args": [
                "--cc",
                "--exe",
                "--build",
                "-Wall",
                "--top-module",
                "delayed_done",
                "-CFLAGS",
                "\"-std=c++17\"",
                "delayed_done.v",
                "sim_main.cpp"
            ],
            "problemMatcher": []
        },
        {
            "label": "Verilator Run",
            "type": "shell",
            "command": "./obj_dir/Vdelayed_done",
            "args": [],
            "problemMatcher": []
        }
    ]
}